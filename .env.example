# Optional settings. Copy this file to ".env" (same folder) to use any of them.
# Everything works with no .env at all.

# ---- AI ----
# Blank = free local AI through Ollama on this PC.
# Add a Claude key (console.anthropic.com, paid per use) to use Claude instead: faster and better writing.
ANTHROPIC_API_KEY=
# Which Ollama models to use (defaults shown).
OLLAMA_TEXT_MODEL=qwen3:4b-instruct
OLLAMA_VISION_MODEL=qwen2.5vl:7b

# ---- Store Analyzer mobile speed test ----
# Free key: Google Cloud → enable "PageSpeed Insights API" → Credentials → API key.
PAGESPEED_API_KEY=

# ---- Sharing the tools with your partner ----
# If set, the app asks for this passcode before opening (needed if you share it beyond your own PC).
APP_PASSCODE=
