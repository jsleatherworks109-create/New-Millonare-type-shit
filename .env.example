# Copy this file to .env for local development. Put the same values in
# Vercel → Project → Settings → Environment Variables when you deploy.
# NEVER commit .env: it holds secret keys. (.gitignore already excludes it.)

# ---- Browser-safe (VITE_ prefix = included in the website) ----
# Blank = DEMO MODE: fake sign-in stored in your browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Server secrets (only the /api function sees these) ----
# Supabase → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=
# console.anthropic.com → API keys. Powers the Content Engine, store advice and launch copy.
ANTHROPIC_API_KEY=
# Free key from Google Cloud (PageSpeed Insights API) for the mobile speed test.
PAGESPEED_API_KEY=

# Stripe → Developers → API keys / Products / Webhooks
STRIPE_SECRET_KEY=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=
STRIPE_WEBHOOK_SECRET=

# Your live site address, e.g. https://selamont.com (used for Stripe return links)
SITE_URL=
